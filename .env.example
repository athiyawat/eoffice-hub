# ==============================================
# e-Office Saraban Manager — Environment Variables
# Copy to .env and fill in values
# ==============================================

# ---- PostgreSQL (existing DB) ----
OPENCLAW_PG_URL=postgresql://app_openclaw:PASSWORD@192.168.111.6:35432/db_openclaw_memory

# ---- Security ----
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=YOUR_FERNET_KEY_HERE

# ---- API Server ----
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://web:3000

# ---- e-Office API (stored encrypted in DB via Settings UI — these are optional overrides) ----
# EOFFICE_TOKEN=
# EOFFICE_BASE_URL=https://eoffice.ntplc.co.th
# EOFFICE_BUCKET_ID=390

# ---- Telegram (stored encrypted in DB via Settings UI — these are optional overrides) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---- AI ----
OPENCLAW_API_BASE=http://openclaw:3000
OPENCLAW_API_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
